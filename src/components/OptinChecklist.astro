---
import OptinBase from "./OptinBase.astro";

/* Wrapper del optin del checklist «para que los clientes te elijan a ti y
   no a otro más barato» (/recursos). Fija el form-id para que su
   automatización de bienvenida dispare por destino del submit, no por
   filtrado de UTMs posterior — los UTMs pueden faltar o llegar
   incorrectos; el form-id siempre llega correcto. Reutiliza el form
   «consultoria-monetizar» (el mismo que OptinConsultoriaMonetizar), el
   único activo en MailerLite: su automatización de bienvenida es la que
   dispara. */
const CHECKLIST_FORM_ID = "192892264186381923";

/* Defaults del botón para este lead magnet: el CTA entrega un recurso
   concreto (el checklist), no una suscripción a emails, así que el texto
   nombra lo que llega; el fuego es el icono de su card en la home y el
   favicon de la landing, y la flecha → repite la de esas cards. La página
   puede overridearlos; el form-id se fija siempre después del spread para
   que la página no pueda pisarlo. */
const {
    botonTexto = "Acceder a los recursos gratuitos",
    botonIcono = "/imgs/svg/fire.svg",
    flecha = true,
    // Form en dos pasos (ver `contacto` en OptinBase): el paso 1 ya guarda
    // el email en MailerLite y dispara la automatización de bienvenida; el
    // paso 2 pide nombre y WhatsApp y actualiza el contacto. Quien abandona
    // en el paso 2 queda en la lista igual.
    contacto = true,
    // El paso 1 sigue siendo el cajetín de siempre, sin etiqueta a la vista,
    // más la casilla obligatoria que filtra las suscripciones accidentales.
    etiquetaEmail = false,
    consentimiento = "Acepto que me contactéis y las burocráticas",
    telefonoLabel = "Número con Whatsapp",
    telefonoNota = "<strong>No te llamaremos,</strong> pero podemos enviarte los recursos por aquí si te es más cómodo",
    botonTextoPaso2 = "Recibir los recursos gratuitos",
    // Este form va SIN doble opt-in en MailerLite (desactivado en el panel):
    // el paso 1 postea al instante y un email de confirmación llegaría antes
    // de terminar el paso 2. Por eso el redirect va directo a /done («ya te
    // llega») y no a /not-done («confirma tu email»), y el evento Lead del
    // pixel salta aquí mismo, en el navegador del anuncio — mejor
    // atribución que desde el email.
    successUrl = "/done",
    ...rest
} = Astro.props;
---

<OptinBase
    {...rest}
    botonTexto={botonTexto}
    botonIcono={botonIcono}
    flecha={flecha}
    contacto={contacto}
    etiquetaEmail={etiquetaEmail}
    consentimiento={consentimiento}
    telefonoLabel={telefonoLabel}
    telefonoNota={telefonoNota}
    botonTextoPaso2={botonTextoPaso2}
    successUrl={successUrl}
    formId={CHECKLIST_FORM_ID}
/>
