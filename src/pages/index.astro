---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    titulo="David Varea (las 2 con V)"
    canonical="/"
    ogTitle="🤝 David Varea (las 2 con V)"
    ogDescription="Consultor de performance: Ventas y Retención del cliente. Cada segundo cuenta."
    description="Audito y mejoro la oferta de quien da servicios (en mercados saturados) para posicionarte como imprescindible y no como una commodity reemplazable."
    ogUrl="https://davidvarea.com"
    bodyClass="home"
>
    <main class="stage">
        <section class="hero-card">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="hero-headline">
                Soy
                <span class="hl-squiggle">
                    David Varea
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"
                        ></path>
                    </svg>
                </span>
                <br />
            </h1>
            <h1 class="hero-headline" style="margin-bottom:1rem">
                <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
            </h1>

            <div class="postit-wrap">
                <div class="postit" style="padding: 1.5rem 0.5rem;">
                    <span class="tape" aria-hidden="true"></span>
                    Consultor de performance:
                    <strong>Ventas y Retención</strong> del cliente
                </div>
            </div>
        </section>

        <div class="section-heading">
            <!-- <span class="caret">▾</span> -->
            ¿Qué te trae por aquí?
        </div>

        <nav class="blocks" aria-label="Secciones">
            <a
                class="block block--secondary block--solo-titulo"
                href="/agenda"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">
                    ⋮⋮
                </span>
                <img class="icon" src="/imgs/svg/fire.svg" alt="🔥" />
                <span class="body">
                    <span class="title">
                        ¿Das servicios en un mercado saturado?
                    </span>
                </span>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
            </a>
            <a
                class="block block--secondary block--solo-titulo"
                href="/recursos"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">
                    ⋮⋮
                </span>
                <img class="icon" src="/imgs/svg/diamond.svg" alt="💎" />
                <span class="body">
                    <span class="title">
                        Recursos para posicionar tu servicio como imprescindible
                    </span>
                </span>
                <span class="badge">GRATIS</span>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
            </a>
        </nav>

        <p class="titulo-mano titulo-mano--nota">Cada segundo cuenta.</p>
    </main>

    <!-- <Footer /> -->

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    ></script>
    <script is:inline>
        Sortable.create(document.querySelector(".blocks"), {
            handle: ".handle",
            animation: 150,
            ghostClass: "block--ghost",
        });
    </script>
</BaseLayout>

<style>
    .hero-headline {
        font-size: 2.4rem;
    }

    @media (max-width: 380px) {
        .hero-headline {
            font-size: 1.9rem;
        }
    }

    @media (min-width: 700px) {
        .hero-headline {
            font-size: clamp(2.133rem, 4.92vh, 2.867rem);
        }
    }
</style>
