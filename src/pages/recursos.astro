---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratuitos"
    ogTitle="🔥 Recursos gratuitos"
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="fire"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1>
                Despide a tu jefe (o a la mayoría de tus clientes siendo
                freelance) para levantar
                <u class="mark-amarillo">tu propio proyecto</u>
                <span class="inciso-ligero">
                    con esta carpeta de{" "}
                    <span class="squiggle">recursos gratis</span>
                </span>
            </h1>
            <p class="inciso-hand">Solo para gente que da servicios online</p>

            <ul class="bold-even">
                <li>
                    Cómo evitar ser una marca blanca que compite bajando el
                    precio.
                </li>
                <li>
                    El peor error de copiar cómo lo está haciendo el referente
                    de tu sector.
                </li>
                <li>
                    El relato para reducir las objeciones y evitar mandar
                    presupuestos.
                </li>
                <li>Y mucho más...</li>
            </ul>
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
