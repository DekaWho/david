---
/* Copy del hero de La Forja (lead magnet de Claude vía Skool) — fuente única:
   lo montan el hero de /claude, OptinCompletoClaudeSkool y el popup
   exit-intent. Editar aquí cambia landing, bloques y popup a la vez. `Tag`
   ajusta la semántica del titular a quien monta: h1 en la landing (único de
   la página), p en los bloques optin (la página que los monta ya tiene su
   propio h1). El titular lleva las dos clases de la escala compacta porque
   .banner-h1--small solo aplica dentro de .banner (la landing) y
   .titulo-compacto replica esa misma escala fuera (bloques y popup). */
const { Tag = "p" } = Astro.props;
---

<Tag class="banner-h1--small titulo-compacto pitch-titular">
    Desbloquea todo tu potencial <span class="aside-hand"
        >(gracias a <u class="banner-mark">desencadenar tu IA</u>)</span
    > para rendir como si tuvieras <span class="ink-circle"
        >100 esclavos<svg
            class="ink-circle-svg"
            viewBox="0 0 100 60"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M 52 6 C 80 7 96 19 94 33 C 93 49 76 55 50 56 C 23 56 6 48 6 30 C 7 14 25 5 52 6"
                stroke="currentColor"
                stroke-width="1.5"
                fill="none"
                stroke-linecap="round"></path></svg
        ></span
    > trabajando para ti
</Tag>

<img
    class="pitch-yunque"
    src="/imgs/forja-yunque.webp"
    alt=""
    width="512"
    height="444"
/>

<p class="bsl-deck bsl-deck--oferta">
    Accede a parte del contenido de La Forja gratis.
</p>
