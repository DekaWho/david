---
const {
  enlaces = [
    { href: '/', label: 'Ir a la home', iconoCasa: true },
    { href: '#contacto', label: 'Contacto', flechaDer: '↓' },
  ],
  /* Excluye al menú del estándar de menús fijos (ocultarse mientras el H1
     está en viewport): queda visible desde la carga. La clase la lee el
     bloque del menú en scripts.js para saltarse el observer. */
  siempreVisible = false,
} = Astro.props;

/* Con un solo enlace el burger es un paso de más (abrir el menú para
   pulsar la única opción): se renderiza el enlace directo y en móvil el
   CSS (.menu--solo) lo pinta como botón-icono donde iría el burger. */
const soloEnlace = enlaces.length === 1;
---
{soloEnlace ? (
  <nav class:list={["menu", "menu--solo", siempreVisible && "menu--siempre-visible"]} aria-label="Navegación principal">
    <a href={enlaces[0].href} class="menu-link" aria-label={enlaces[0].label}>
      {enlaces[0].iconoCasa && (
        <svg class="menu-link-icon" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
          <path d="M192 413.952V896h640V413.952L512 147.328 192 413.952zM139.52 374.4l352-293.312a32 32 0 0 1 40.96 0l352 293.312A32 32 0 0 1 896 398.976V928a32 32 0 0 1-32 32H160a32 32 0 0 1-32-32V398.976a32 32 0 0 1 11.52-24.576z"/>
        </svg>
      )}
      <span class="menu-link-label">{enlaces[0].label}</span>
    </a>
  </nav>
) : (
<nav class:list={["menu", siempreVisible && "menu--siempre-visible"]} aria-label="Navegación principal">
  <input type="checkbox" id="menu-toggle" aria-label="Abrir menú" />
  <label for="menu-toggle" class="burger" aria-hidden="true">
    <span></span><span></span><span></span>
  </label>
  <div class="links">
    {enlaces.map((link, i) => (
      <>
        {i > 0 && <span class="menu-divider" aria-hidden="true">|</span>}
        <a href={link.href} class="menu-link">
          {link.iconoCasa && (
            <svg class="menu-link-icon" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
              <path d="M192 413.952V896h640V413.952L512 147.328 192 413.952zM139.52 374.4l352-293.312a32 32 0 0 1 40.96 0l352 293.312A32 32 0 0 1 896 398.976V928a32 32 0 0 1-32 32H160a32 32 0 0 1-32-32V398.976a32 32 0 0 1 11.52-24.576z"/>
            </svg>
          )}
          <span>{link.label}</span>
          {link.flechaDer && (
            <span class="menu-link-arrow" aria-hidden="true">{link.flechaDer}</span>
          )}
        </a>
      </>
    ))}
  </div>
</nav>
)}
