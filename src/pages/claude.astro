---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinClaudeSkool from "../components/OptinClaudeSkool.astro";
import PitchClaudeSkool from "../components/PitchClaudeSkool.astro";
import CuerpoClaudeSkool from "../components/CuerpoClaudeSkool.astro";
---

<BaseLayout
    titulo="Rinde como si tuvieras 100 esclavos (sin necesidad de contratar y gracias a adaptar la IA a tu negocio en concreto)"
    canonical="/claude"
    ogTitle="Rinde como si tuvieras 100 esclavos (sin necesidad de contratar y gracias a adaptar la IA a tu negocio en concreto)"
    ogUrl="https://davidvarea.com/claude"
    favicon="fire"
    bodyClass="claude"
    exitPopup={false}
>
    <div class="banner">
        <section class="hero hero--la-forja" id="inicio">
            <PitchClaudeSkool Tag="h1" />

            <OptinClaudeSkool />

            <p>Mira el vídeo para ver una de las skills</p>

            <video
                class="hero-video"
                controls
                controlslist="nodownload"
                preload="none"
                playsinline
                poster="/videos/claude-hero-poster.webp"
                width="1920"
                height="1080"
            >
                <source src="/videos/claude-hero.webm" type="video/webm" />
                <source src="/videos/claude-hero.mp4" type="video/mp4" />
                Tu navegador no puede reproducir este vídeo.
            </video>
        </section>
    </div>

    <div class="cuerpo cuerpo--la-forja">
        <CuerpoClaudeSkool />
    </div>
    <div class="flecha flecha--up" aria-hidden="true"></div>
</BaseLayout>

{
    /* Title parpadeante estilo notificación de WhatsApp: se dispara cuando el
        lector deja de mirar la página, para reengancharlo. Cubre los dos casos
        de "irse": cambiar de pestaña/minimizar (visibilitychange) y mover el
        foco a otro programa con la pestaña aún activa (blur de window) — este
        último no levanta document.hidden, de ahí los dos disparadores y el
        document.hasFocus(). Al recuperar foco se restaura el título. Inline por
        ser exclusivo de esta landing. */
}
<script is:inline>
    (function () {
        const original = document.title;
        const alerta = "(1) " + original;
        let timer = null;
        let mostrandoAlerta = false;

        function arrancar() {
            if (timer) return;
            timer = setInterval(function () {
                document.title = mostrandoAlerta ? original : alerta;
                mostrandoAlerta = !mostrandoAlerta;
            }, 1000);
        }

        function parar() {
            clearInterval(timer);
            timer = null;
            document.title = original;
        }

        function sincronizar() {
            if (document.hidden || !document.hasFocus()) arrancar();
            else parar();
        }

        document.addEventListener("visibilitychange", sincronizar);
        window.addEventListener("blur", sincronizar);
        window.addEventListener("focus", sincronizar);
    })();
</script>
