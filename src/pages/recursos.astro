---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratis para crear tu propio servicio si eres closer."
    ogTitle="Recursos gratis para crear tu propio servicio si eres closer."
    description="Recursos gratis para crear tu propio servicio si eres closer."
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="diamond"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1>
                Recursos gratis para crear tu servicio{" "}
                <u class="mark-amarillo">si eres closer</u> y te sabe a poco la
                comisión <span class="squiggle">del 10%</span>
            </h1>
            <ul class="bold-even">
                <li>
                    El checklist para crear una oferta desde cero en un mercado
                    saturado.
                </li>
                <li>
                    El peor error de copiar cómo lo está haciendo el referente
                    de tu sector.
                </li>
                <li>
                    Las 5 técnicas de persuasión oscura que ha usado Perro Sanxe
                    para hipnotizar a media España y posicionarse por encima de
                    su competencia.
                </li>
                <li>Y varios google docs más...</li>
            </ul>
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
