---
/* HTML/CSS y comportamiento base del optin del sitio. NO incrustar
   directamente en una página: cada lead magnet vive en su propio wrapper
   (OptinConsultoriaMonetizar, …) que fija el form-id de MailerLite para que
   la automatización de bienvenida correcta dispare por destino del submit,
   no por filtrado de UTMs posterior.

   El handler de submit y la captura de atribución (utm_source/medium/
   content + referrer + ultimo_optin) viven en public/scripts/scripts.js
   — se enganchan por el selector form[data-ml-form-id], así que este
   componente no necesita props ni código para participar. Ver
   web-code/CLAUDE.md → "Integraciones externas → MailerLite → Atribución
   de origen" antes de añadir campos o tocar el sistema. */

const {
    id,
    formId,
    successUrl = "/not-done",
    botonTexto = "Recibir gratis los valiosos emails",
    botonIcono = "/imgs/svg/email.svg",
    mostrarPrivacyNote = true,
    // `flecha`: añade al botón la flecha → de los enlaces-tarjeta de la home
    // (.block .arrow), para que el CTA del optin se lea igual que ellos.
    flecha = false,
    // `posicion`: fija el campo posicion_optin de MailerLite en lugar del
    // ordinal DOM que calcula el handler de scripts.js. Para optins fuera
    // del flujo de la página, cuyo índice variaría según cuántos forms tenga
    // cada página y no identificaría nada.
    posicion,
    // `segmentar`: form en dos pasos. El paso 1 es el cajetín de siempre
    // (email + botón); al pulsar, el handler de scripts.js esconde el email
    // y muestra las dos preguntas de segmentación (radios, sin teclear),
    // ambas obligatorias. El POST a MailerLite sale SOLO cuando las dos
    // están respondidas — si el visitante se va a medias no entra en la
    // lista. Es el filtro contra las suscripciones accidentales (autofill
    // del navegador de Instagram): el autofill rellena el email, no las
    // preguntas. Los valores viajan como fields[situacion] y fields[sector];
    // los slugs deben existir tal cual como campos custom en MailerLite.
    segmentar = false,
    // `contacto`: form en dos pasos que pide nombre y teléfono (ambos
    // obligatorios) en el paso 2 en lugar de las preguntas de `segmentar`.
    // A diferencia de aquel, el email se guarda en MailerLite ya en el paso 1
    // (data-ml-guardar-paso1): quien deja el email y abandona queda en la
    // lista. El paso 2 vuelve a postear al mismo form, que actualiza el
    // contacto con fields[name] y fields[phone] (campos por defecto de
    // MailerLite).
    contacto = false,
    // Texto del botón en el paso 2 (con `segmentar` o `contacto`).
    botonTextoPaso2 = "Enviar",
    // `cerrado`: estado "plazas cerradas". El cajetín se ve pero queda inerte
    // (sin data-ml-form-id, input y botón disabled) bajo la cinta de obras y
    // un cartel. El handler de scripts.js solo engancha form[data-ml-form-id],
    // así que al omitirlo el optin deja de postear a MailerLite. Un optin
    // cerrado puede vivir sin formId: es el placeholder de un lead magnet
    // retirado cuyo form ya no existe en MailerLite.
    cerrado = false,
} = Astro.props;

if (!formId && !cerrado) {
    throw new Error(
        "OptinBase.astro: prop `formId` requerida en un optin activo. No incrustar este componente directamente — usar un wrapper por lead magnet (<OptinConsultoriaMonetizar />, …) o crear uno nuevo.",
    );
}

/* Preguntas de segmentación. El `name` es el slug del campo custom en
   MailerLite; el `value` es lo que se guarda (corto, sin acentos, apto
   para segmentos). Sin atributo `required`: las validamos en scripts.js,
   porque un radio required dentro de un bloque oculto bloquearía el
   submit del paso 1 con la burbuja nativa sobre un elemento invisible. */
const preguntas = [
    {
        name: "situacion",
        legend: "¿En qué punto estás?",
        opciones: [
            { value: "asalariado", label: "Soy asalariado" },
            {
                value: "freelance",
                label: "Soy freelance y ya he tenido clientes",
            },
            {
                value: "negocio",
                label: "Tengo mi propio negocio con clientes recurrentes cada mes",
            },
        ],
    },
    {
        name: "sector",
        legend: "¿En qué sector te mueves?",
        opciones: [
            { value: "marketing", label: "Marketing, publicidad o redes" },
            {
                value: "consultoria",
                label: "Consultoría, asesoría o dar servicios",
            },
            {
                value: "formacion",
                label: "Formación, coaching o infoproductos",
            },
            { value: "salud", label: "Salud, fitness o bienestar" },
            { value: "ecommerce", label: "Producto físico o ecommerce" },
            { value: "software", label: "Software o tecnología" },
            { value: "otro", label: "Otro" },
        ],
    },
];
---

<form
    class:list={["optin", { "optin--cerrado": cerrado }]}
    id={id}
    data-ml-form-id={cerrado ? undefined : formId}
    data-ml-success={cerrado ? undefined : successUrl}
    data-ml-posicion={cerrado ? undefined : posicion}
    data-ml-paso2={(segmentar || contacto) && !cerrado ? botonTextoPaso2 : undefined}
    data-ml-guardar-paso1={contacto && !cerrado ? "" : undefined}
>
    {/* Con `contacto` el email lleva etiqueta a la vista, como los campos
        del paso 2; el cajetín de los lead magnets la mantiene oculta. */}
    <label class:list={["optin-email", { "optin-email--etiqueta": contacto }]}>
        {contacto
            ? <span class="optin-campo-label">Tu email</span>
            : <span class="visually-hidden">Email</span>}
        <input
            type="email"
            name="email"
            placeholder="tucorreo@email.com"
            autocomplete="email"
            required
            disabled={cerrado}
        />
    </label>
    {segmentar && !cerrado && (
        <>
            <p class="optin-email-fijado" hidden>
                <span class="optin-email-valor"></span>
                <button type="button" class="optin-email-cambiar">
                    cambiar
                </button>
            </p>
            <div class="optin-paso2" hidden>
                {preguntas.map((p) => (
                    <fieldset class="optin-pregunta" data-pregunta={p.name}>
                        <legend>{p.legend}</legend>
                        <div class="optin-opciones">
                            {p.opciones.map((o) => (
                                <label class="optin-opcion">
                                    <input
                                        type="radio"
                                        name={p.name}
                                        value={o.value}
                                    />
                                    <span>{o.label}</span>
                                </label>
                            ))}
                        </div>
                        <p class="optin-error" hidden>
                            Te falta responder esta pregunta
                        </p>
                    </fieldset>
                ))}
            </div>
        </>
    )}
    {contacto && !cerrado && (
        <>
            <p class="optin-email-fijado" hidden>
                <span class="optin-email-valor"></span>
                <button type="button" class="optin-email-cambiar">
                    cambiar
                </button>
            </p>
            {/* Sin `required` por el mismo motivo que los radios: ocultos en
                el paso 1, bloquearían su submit. Los valida scripts.js. */}
            <div class="optin-paso2" hidden>
                <label class="optin-campo" data-campo="name">
                    <span class="optin-campo-label">
                        Tu nombre<span class="optin-obligatorio" aria-hidden="true">*</span>
                    </span>
                    <input
                        type="text"
                        name="name"
                        autocomplete="name"
                        aria-required="true"
                    />
                    <span class="optin-error" hidden>
                        Te falta poner tu nombre
                    </span>
                </label>
                {/* Prefijo y número en dos cajas para que quien no es de
                    España vea dónde va el suyo. El "+" va pintado delante
                    del prefijo para que no haga falta escribirlo (si lo
                    escriben, scripts.js lo limpia); vacío cuenta como +34.
                    Sin validar formato: scripts.js los une en el campo
                    phone. Cada caja va en su <label>, con la pista de
                    debajo como nombre accesible. */}
                <div class="optin-campo" data-campo="phone">
                    <span class="optin-campo-label">
                        Tu número<span class="optin-obligatorio" aria-hidden="true">*</span>
                    </span>
                    <div class="optin-telefono">
                        <label class="optin-telefono-parte optin-telefono-parte--prefijo">
                            <span class="optin-prefijo-caja">
                                <span class="optin-prefijo-mas" aria-hidden="true">+</span>
                                <input
                                    class="optin-prefijo"
                                    type="tel"
                                    placeholder="34"
                                    autocomplete="tel-country-code"
                                    inputmode="tel"
                                />
                            </span>
                            <span class="optin-telefono-pista">Prefijo de tu país</span>
                        </label>
                        <label class="optin-telefono-parte">
                            <input
                                type="tel"
                                placeholder="777 777 777"
                                autocomplete="tel-national"
                                inputmode="tel"
                                aria-required="true"
                            />
                            <span class="optin-telefono-pista">Número de teléfono</span>
                        </label>
                    </div>
                    <span class="optin-error" hidden>
                        Te falta poner tu teléfono
                    </span>
                </div>
            </div>
        </>
    )}
    {mostrarPrivacyNote && !cerrado && (
        <p class="privacy-note">
            Puedes leer las burocráticas políticas de privacidad
            <a href="/privacidad" target="_blank" rel="noopener">
                aquí
            </a>
        </p>
    )}
    <button type="submit" class="block block--primary" disabled={cerrado}>
        <img class="icon" src={botonIcono} alt="" />
        <span class="body">
            <span class="title">{botonTexto}</span>
        </span>
        {flecha && (
            <span class="arrow" aria-hidden="true">
                →
            </span>
        )}
    </button>
    {cerrado && <span class="optin-cerrado-cartel">Acceso cerrado</span>}
</form>
