---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
import Reviews from "../components/Reviews.astro";
import AgendarLlamada from "../components/AgendarLlamada.astro";
import CarruselVideos from "../components/CarruselVideos.astro";

// Para pausar el amago de scroll, cambiar la línea activa por esta:
// const bodyClass = "reviews-blanco oferta agenda title-alerta";
const bodyClass = "reviews-blanco oferta agenda title-alerta amago-scroll";
---

<BaseLayout
    titulo="¿Tu comisión del 10% te sabe a poco?"
    canonical="/agenda"
    ogTitle="¿Tu comisión del 10% te sabe a poco?"
    ogDescription="Cuidado con..."
    description="¿Tu comisión del 10% te sabe a poco? Instalo nuevas ofertas para closers que quieren crear su propio servicio."
    ogUrl="https://davidvarea.com/agenda"
    favicon="fire"
    bodyClass={bodyClass}
>
    <div class="banner">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>

            <h1 class="banner-h1--medium">
                Instalo ofertas irresistibles{" "}
                <u class="mark-amarillo">para closers</u> que la comisión del{" "}
                <span class="squiggle">10% les sabe a poco</span> y quieren
                crear su propio servicio
                <span class="inciso-hand">
                    (incluso en un mercado saturado)
                </span>
            </h1>
            <AgendarLlamada />
        </section>
    </div>

    <div class="cuerpo">
        <h2 class="titulo-compacto">
            Me he gastado 19.970€ en mentorías para diseñar y posicionar ofertas{" "}
            <span class="inciso-hand">
                (además de mi experiencia dando servicios y consumir 952 horas
                de contenido)
            </span>
            para que tú no tengas que hacerlo...
        </h2>

        <img
            class="banner-proof"
            src="/imgs/referentes.webp"
            alt="las caras de los referentes estudiados"
            loading="lazy"
            decoding="async"
        />
    </div>

    <Reviews id="opiniones" orden={["pascu", "gonzalo", "cristina", "rioboo"]}>
        <p slot="antes-audios">
            <strong>
                Esto dice quien
                <span class="squiggle">ha trabajado conmigo.</span>
            </strong>
        </p>
        <p slot="antes-audios">
            He dado servicios en distintos nichos hasta encontrar la mejor
            fórmula para diferenciar tu servicio incluso en un mercado saturado.
        </p>
    </Reviews>

    <div class="cuerpo">
        <AgendarLlamada />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <div class="cta-sticky">
        <AgendarLlamada posicion="99" />
    </div>

    <FooterDisclaimer />
</BaseLayout>
