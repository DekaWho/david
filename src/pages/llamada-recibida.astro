---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    titulo="Llamada agendada"
    noindex={true}
    scripts={false}
    trackEvento="Schedule"
>
    <h1
        class="titulo-breaker titulo-breaker--bg-claro"
        style="color:var(--rojo)"
    >
        Llamada agendada
    </h1>

    <div class="cuerpo">
        {/* El script de abajo cambia «el día y a la hora que has elegido»
            por la cita concreta; sin dato guardado (enlace directo) la frase
            genérica se queda. */}
        <p>
            Nos vemos{" "}
            <strong data-cita>el día y a la hora que has elegido</strong>.
        </p>
        <p>
            Te acabo de mandar por email el enlace a la call. Acéptala para
            guardarla en tu calendario (si no la ves revisa la carpeta de spam).
        </p>
    </div>

    <script is:inline>
        (() => {
            let cita = "";
            try {
                cita = sessionStorage.getItem("lead_cita") || "";
            } catch (_) {}
            const partes = cita.match(
                /^(\d{4})-(\d{2})-(\d{2}) (\d{1,2}:\d{2})$/,
            );
            if (!partes) return;
            const [, anio, mes, dia, hora] = partes;
            const fecha = new Date(anio, mes - 1, dia).toLocaleDateString(
                "es-ES",
                {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                },
            );
            document.querySelector("[data-cita]").textContent =
                `el ${fecha} a las ${hora} (hora de España peninsular)`;
        })();
    </script>
</BaseLayout>
