---
import OptinClaudeSkool from "./OptinClaudeSkool.astro";
import PitchClaudeSkool from "./PitchClaudeSkool.astro";

/* Popup de exit-intent con el optin de La Forja. Lo monta BaseLayout en toda
   página con scripts.js que no opte fuera vía exitPopup={false}, y PostLayout
   en todos los posts. El HTML viaja oculto ([hidden]) en la página; el bloque
   de scripts.js lo revela según el dispositivo — escritorio: el ratón sale
   del viewport por arriba (exit-intent); móvil: retorno tras ≥10s en otra
   app o 45s de inactividad. Visto una vez → 24h de silencio en todo el
   navegador, y nunca para quien ya envió un optin.

   El pitch es la misma fuente única del hero de /claude y del cierre de los
   posts (PitchClaudeSkool): editar la pieza actualiza también este popup
   (ajustes de escala propios vía CSS, scope .exit-popup). posicion="99" etiqueta
   en MailerLite la suscripción como llegada por el popup — el ordinal DOM
   del form variaría por página y no identificaría nada; en táctil scripts.js
   lo reescribe a 98 para separar la variante móvil de la de escritorio.

   La X vive fuera de .exit-popup-scroll (el área que scrollea si el
   viewport es bajo) para quedar siempre visible en la esquina de la carta. */

/* Interruptor del popup en todo el sitio. Con false el componente renderiza
   vacío: los layouts lo siguen montando sin efecto y el bloque de scripts.js
   sale limpio al no encontrar #exit-popup. Reactivarlo = ponerlo a true. */
const POPUP_ACTIVO = false;
---

{POPUP_ACTIVO && (
<div class="exit-popup" id="exit-popup" hidden>
    <div
        class="exit-popup-card"
        role="dialog"
        aria-modal="true"
        aria-label="Accede gratis a La Forja"
    >
        <button type="button" class="exit-popup-close" aria-label="Cerrar">
            &times;
        </button>
        <div class="exit-popup-scroll">
            <section class="optin-bloque optin-bloque--forja">
                <PitchClaudeSkool />
                <OptinClaudeSkool posicion="99" />
            </section>
        </div>
    </div>
</div>
)}
