---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { CALENDARIO_URL } from "../data/calendario.js";
---

<BaseLayout
    titulo="David Varea (las 2 con V)"
    canonical="/"
    ogTitle="🤝 David Varea"
    ogDescription="Cada segundo cuenta."
    ogUrl="https://davidvarea.com"
    bodyClass="home"
>
    <main class="stage">
        <section class="hero-card">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="hero-headline" style="margin-bottom: 2rem;">
                Soy
                <span class="hl-squiggle">
                    David Varea
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"
                        ></path>
                    </svg>
                </span>{" "}
                <br />
                <span class="inciso-ligero">(las dos con V)</span>
            </h1>

            <div class="postit-wrap">
                <div class="postit" style="padding: 1.5rem 0;">
                    <span class="tape" aria-hidden="true"></span>
                    Estratega en procesos de venta y experto en persuasión.
                </div>
            </div>
        </section>

        <div class="section-heading">
            <!-- <span class="caret">▾</span> -->
            ¿Qué te trae por aquí?
        </div>

        <nav class="blocks" aria-label="Secciones">
            <a
                class="block block--secondary block--solo-titulo"
                href="/recursos"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">
                    ⋮⋮
                </span>
                <img class="icon" src="/imgs/svg/fire.svg" alt="🔥" />
                <span class="body">
                    <span class="title">
                        Recursos Gratis para líderes de opinión
                    </span>
                </span>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
            </a>

            <a
                class="block block--secondary block--solo-titulo"
                href="/oferta"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">
                    ⋮⋮
                </span>
                <img class="icon" src="/imgs/svg/diamond.svg" alt="💎" />
                <span class="body">
                    <span class="title">
                        Vender con una Oferta Incuestionable
                    </span>
                </span>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
            </a>

            <a
                class="block block--secondary block--solo-titulo"
                href="/youtube"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">
                    ⋮⋮
                </span>
                <img class="icon" src="/imgs/svg/youtube.svg" alt="📷" />
                <span class="body">
                    <span class="title">Plagiar outliers es de pagafantas</span>
                </span>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
            </a>
        </nav>

        <p class="titulo-mano titulo-mano--nota">Cada segundo cuenta.</p>
    </main>

    <!-- <Footer /> -->

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    ></script>
    <script is:inline>
        Sortable.create(document.querySelector(".blocks"), {
            handle: ".handle",
            animation: 150,
            ghostClass: "block--ghost",
        });
    </script>
</BaseLayout>

<style>
    .hero-headline {
        font-size: 2.4rem;
    }

    @media (max-width: 380px) {
        .hero-headline {
            font-size: 1.9rem;
        }
    }

    @media (min-width: 700px) {
        .hero-headline {
            font-size: clamp(2.133rem, 4.92vh, 2.867rem);
        }
    }
</style>
