---
import BaseLayout from "../layouts/BaseLayout.astro";
import ElegirHora from "../components/ElegirHora.astro";
---

<BaseLayout
    titulo="¿Quieres ir más rápido?"
    favicon="warning"
    bodyClass="hoja-blanca"
    noindex={true}
    scripts={false}
    trackEvento="Lead"
>
    <div class="banner" style="padding-top: 1.5rem;">
        <section class="hero">
            <img class="hero-aviso" src="/imgs/svg/warning-color.svg" alt="" />
            <h1 style="color: var(--rojo);">Cuidado</h1>
            <p style="text-align: center; margin-bottom: var(--gap-sm);">
                <strong>
                    En la carpeta hay{" "}
                    <span class="squiggle">distintos recursos.</span>
                    Si quieres
                    <u class="mark-amarillo">una ruta personalizada</u> para
                    quedarte con el 100% de lo que generan tus ventas te la
                    cuento en una llamada de media hora.
                </strong>
            </p>
        </section>

        <ElegirHora />
    </div>
</BaseLayout>
