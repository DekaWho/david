---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
---

<BaseLayout
    titulo="Checklist para que te elijan a ti"
    ogTitle="🧲 Checklist para que los clientes te elijan a ti y no a otro más barato"
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="fire"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>

            <h1>
                Si quieres posicionarte como líder de opinión en tu sector para
                tener un <u class="mark-amarillo">imán de oportunidades</u> sin
                necesidad de gastar ni 1€ en publicidad{" "}
                <span class="inciso-hand">
                    (Aumentando tu reputación, atrayendo a clientes ideales y
                    reduciendo las objeciones que tienen antes de pagar por tu
                    servicio)
                </span>{" "}
                he creado un checklist para que los clientes te elijan a ti y no
                a otro más barato...
            </h1>
        </section>

        <OptinChecklist />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>
</BaseLayout>
