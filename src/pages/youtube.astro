---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
import Logros from "../components/Logros.astro";
import Reviews from "../components/Reviews.astro";
import CalendarioGoogle from "../components/CalendarioGoogle.astro";
---

<BaseLayout
    titulo="¿Copias outliers?"
    ogTitle="¿Plagias outliers?"
    ogDescription="¿En serio?"
    canonical="/youtube"
    ogUrl="https://davidvarea.com/youtube"
    favicon="youtube"
    bodyClass="reviews-blanco youtube title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <img
                class="hero-youtube"
                src="/imgs/svg/youtube.svg"
                alt="YouTube"
            />

            <h1>
                Plagiar outliers es de{" "}
                <span class="squiggle">pagafantas. </span>Si quieres
                posicionarte como líder de opinión y no como una marca blanca
                <u class="mark-amarillo">mejor llámame</u> para una
                consultoría+auditoría
            </h1>

            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>
        </section>
        <CalendarioGoogle />
    </div>

    {/* Única página que se sale del orden por defecto: aquí la prueba que más
    pesa es la placa de 100k, que habla de la plataforma de la que va la
    landing, así que abre la franja y Pascual la cierra. */}
    <Reviews id="opiniones" orden={["chuso", "rioboo", "gonzalo", "pascu"]} />

    <div class="cuerpo">
        <h2 id="agendar" style="font-family: var(--hand); color: var(--rojo)">
            Qué recibes en la&nbsp;llamada
        </h2>

        <img
            class="emoji-3d"
            src="/imgs/pill-3d.webp"
            width="256"
            height="256"
            alt=""
            aria-hidden="true"
        />

        <p style="margin-bottom: 1rem;">
            <strong>Un diagnóstico de tu canal para descubrir:</strong>
        </p>

        <ul>
            <li>
                Si te sale más rentable buscar visitas o hacer vídeos de nicho
                para un público reducido.
            </li>
            <li>
                <strong>
                    Cómo Youtube puede ser tu máquina de cualificar leads para
                    calentarlos y reducir las objeciones que te ponen antes de
                    comprar (aumentando la tasa de cierre).
                </strong>
            </li>
            <li>
                Cuáles son los siguientes vídeos que tiene más sentido grabar
                para aumentar la reputación de tu marca personal.
            </li>
            <!-- <li>
                <strong>
                    Si este programa de acompañamiento 1a1 durante 90 días puede
                    ayudarte y cuál es el siguiente paso para trabajar juntos.
                </strong>
            </li> -->
        </ul>

        <CalendarioGoogle />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
