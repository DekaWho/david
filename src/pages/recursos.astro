---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratuitos para que te elijan a ti"
    ogTitle="🔥 Recursos gratuitos para que los clientes te elijan a ti y no a otro más barato"
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="fire"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>

            <h1>
                Si quieres posicionarte como líder de opinión para captar leads
                más{" "}
                <span class="hl-squiggle">
                    calientes
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"
                        ></path>
                    </svg>
                </span>{" "}
                que una croqueta recién hecha{" "}
                <span class="inciso-ligero">(usando contenido orgánico)</span>{" "}
                Mira gratis esta carpeta llena de recursos sobre...{" "}
                <span class="inciso-hand">
                    Aumentar tu reputación, atraer oportunidades, reducir
                    objeciones y diferenciarte para no parecer la copia de la
                    copia
                </span>
            </h1>
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
