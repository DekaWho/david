---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratis para tener tu propio proyecto si eres closer."
    ogTitle="Recursos gratis para tener tu propio proyecto si eres closer."
    description="Recursos gratis para tener tu propio proyecto si eres closer."
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="diamond"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">Solo para Closers</span>
            </h2>

            <h1>
                Recursos gratis <u class="mark-amarillo">para quedarte todo</u>{" "}
                lo generado con tus ventas y dejar de{" "}
                <span class="squiggle">cobrar migajas</span> mientras levantas
                el negocio de otro
            </h1>
            <ul class="bold-even">
                <li>
                    El checklist para montar una oferta desde cero en un mercado
                    saturado.
                </li>
                <li>
                    El peor error de copiar cómo lo están haciendo otros closers
                    referentes.
                </li>
                <li>
                    Lanzar al mercado tu proyecto sin gastar tiempo en el
                    servicio hasta que ya te han pagado.
                </li>
                <li>Y varios google docs más...</li>
            </ul>
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
