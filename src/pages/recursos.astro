---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratis para posicionar tu servicio como imprescindible"
    ogTitle="🔥 Recursos gratis para posicionar tu servicio como imprescindible"
    description="Recursos gratis para posicionar tu servicio como imprescindible y no como una commodity reemplazable en un mercado saturado."
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="diamond"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1>
                Recursos gratis para posicionar{" "}
                <u class="mark-amarillo">tu servicio</u> como imprescindible
                <span class="inciso-hand">
                    y no como una{" "}
                    <span class="squiggle">commodity reemplazable</span>
                </span>
            </h1>
            <!--
            <ul class="bold-even">
                <li>
                    Cómo evitar ser una marca blanca que compite bajando el
                    precio.
                </li>
                <li>
                    El peor error de copiar cómo lo está haciendo el referente
                    de tu sector.
                </li>
                <li>
                    El relato para reducir las objeciones y evitar mandar
                    presupuestos.
                </li>
                <li>Y mucho más...</li>
            </ul> -->
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
