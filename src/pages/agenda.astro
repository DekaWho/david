---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
import Reviews from "../components/Reviews.astro";
import AgendarLlamada from "../components/AgendarLlamada.astro";
import CarruselVideos from "../components/CarruselVideos.astro";

// Para pausar el amago de scroll, cambiar la línea activa por esta:
// const bodyClass = "reviews-blanco oferta agenda title-alerta";
const bodyClass = "reviews-blanco oferta agenda title-alerta amago-scroll";
---

<BaseLayout
    titulo="¿Te conformas con migajas?"
    canonical="/agenda"
    ogTitle="¿Te conformas con migajas?"
    ogDescription="Solo para Closers."
    description="¿Te conformas con migajas? Lanzamos al mercado tu propio proyecto para que te quedes el 100% de lo que generan tus ventas."
    ogUrl="https://davidvarea.com/agenda"
    favicon="fire"
    bodyClass={bodyClass}
>
    <div class="banner">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="banner-h1--medium">
                <span class="h1-linea">
                    ¿Te conformas con <span class="squiggle">migajas?</span>
                </span>
                <span class="h1-linea inciso-hand text-rojo">
                    ¿Y con una comisión del 10%?
                </span>
                <span class="h1-linea">
                    Lanzamos al mercado tu propio proyecto para que{" "}
                    <u class="mark-amarillo">te quedes TODO lo generado</u> con
                    tus ventas{" "}
                    <span class="inciso-ligero">
                        (sin necesidad de salirte de tus proyectos actuales)
                    </span>
                </span>
            </h1>
            <AgendarLlamada />
            <p>
                En 30 días lo montamos para ti y luego te acompañamos en
                sesiones 1a1 durante 6 meses. No apto para setters, solo si eres
                closer.
            </p>
        </section>
    </div>

    <div class="cuerpo cuerpo--blanco">
        <span
            class="doodle doodle--diamante doodle--azul"
            aria-hidden="true"
        ></span>
        <div class="historia">
            <p>
                <strong>¿Cuánto has ganado este mes?</strong>
            </p>
            <p>¿5100&nbsp;€? ¿2700&nbsp;€? ¿6400&nbsp;€?</p>
            <p>Buen sueldo.</p>
            <p>
                <strong>
                    Sobre todo si se lo cuentas a tu yo del pasado, el que luchó
                    por llegar donde estás.
                </strong>
            </p>
            <p>
                <span class="inciso-hand text-rojo">
                    Pero ahora hazte las preguntas incómodas que él no sabría
                    hacerse:
                </span>
            </p>
            <p>¿Cuánto te llevas de cada venta?</p>
            <p>¿Cuántas llamadas has necesitado este mes para llegar ahí?</p>
            <p>Y...</p>
            <p>
                <strong>
                    Para tú recibir ese dinero mensual ¿Cuánto ha facturado el
                    negocio gracias a ti?
                </strong>
            </p>
        </div>

        <span class="doodle doodle--sisifo" aria-hidden="true"></span>
        <div class="historia">
            <p>
                Aunque puedes <span class="squiggle">darle la vuelta:</span>
            </p>
            <p>
                Si el proyecto fuese tuyo ¿Cuántas llamadas al mes necesitas
                para ganar lo mismo que has ganado este último mes?
            </p>
            <p>
                <strong>
                    Si tu comisión es del 10% entonces necesitarías vender unas
                    10 veces menos que ahora.
                </strong>
            </p>
            <p>
                <span class="inciso-hand text-rojo">
                    De cada 10 llamadas que has tenido necesitarías tener solo 1
                    para igualar tus ingresos actuales.
                </span>
            </p>
            <p>
                ¿No preferirías estar en el mismo punto haciendo diez veces
                menos?
            </p>
            <p>
                <strong>
                    ¿O hacer{" "}
                    <u class="mark-amarillo">lo mismo ganando 10 veces más?</u>
                </strong>
            </p>
        </div>

        <p>
            Lo más difícil en un negocio es la parte comercial y tú justo ya
            eres bueno vendiendo. ¿Te atreves a cobrar lo que mereces o te
            conformas con un 10%?
        </p>

        <span
            class="doodle doodle--trofeo doodle--azul"
            aria-hidden="true"
        ></span>

        <h2 class="titulo-compacto">
            He estudiado incontables horas de contenido y{" "}
            <span class="squiggle">he invertido 19.970€</span> en formación para
            diseñar y posicionar ofertas{" "}
            <span class="inciso-hand">
                (además de mi experiencia dando servicios en distintos nichos)
            </span>
            para que tú no tengas que hacerlo...
        </h2>

        <img
            class="banner-proof"
            src="/imgs/referentes.webp"
            alt="las caras de los referentes estudiados"
            loading="lazy"
            decoding="async"
        />
    </div>

    <Reviews id="opiniones" orden={["pascu", "gonzalo", "cristina", "rioboo"]}>
        <p slot="antes-audios">
            <strong>
                Esto dice
                <span class="squiggle">quien ha trabajado</span> conmigo.
            </strong>
        </p>
        <p slot="antes-audios">
            He dado servicios en distintos nichos hasta encontrar la mejor
            fórmula para diferenciar tu servicio incluso en un mercado saturado.
        </p>
    </Reviews>

    <div class="cuerpo">
        <AgendarLlamada />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <div class="cta-sticky">
        <AgendarLlamada posicion="99" />
    </div>

    <FooterDisclaimer />
</BaseLayout>
