---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptinChecklist from "../components/OptinChecklist.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
---

<BaseLayout
    titulo="Recursos gratuitos"
    ogTitle="🔥 Recursos gratuitos"
    canonical="/recursos"
    ogUrl="https://davidvarea.com/recursos"
    favicon="fire"
    bodyClass="recursos title-alerta"
>
    <div class="banner banner--presentacion">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>

            <h1>
                Despide a tu jefe (o a{" "}
                <u class="mark-amarillo">la mayoría de tus clientes</u> siendo
                freelance)
                <span class="inciso-hand">
                    con esta carpeta de{" "}
                    <span class="squiggle">recursos gratis</span> si puedes dar
                    servicios online
                </span>
            </h1>

            <ul class="bold-even">
                <li>
                    Cómo evitar ser una marca blanca que compite bajando el
                    precio.
                </li>
                <li>
                    El peor error de copiar cómo consigue clientes el referente
                    de tu sector.
                </li>
                <li>
                    El relato para reducir las objeciones que te ponen antes de
                    pagar tu servicio.
                </li>
                <li>Y mucho más...</li>
            </ul>
        </section>

        <OptinChecklist
            botonTexto="Acceder a la carpeta compartida"
            botonTextoPaso2="Acceder a la carpeta compartida"
        />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <FooterDisclaimer />
</BaseLayout>
