---
// Imagen de prueba del pitch de Róbame — fuente única. La monta el hero
// de /robame (loading="eager": está en el fold).
const { loading = "lazy" } = Astro.props;
---

<img
    class="banner-proof"
    src="/imgs/heads.webp"
    alt="las caras de los referentes estudiados"
    loading={loading}
    decoding="async"
/>
