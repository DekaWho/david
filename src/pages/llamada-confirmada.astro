---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    titulo="Ya casi está"
    noindex={true}
    scripts={false}
    trackEvento="Schedule"
>
    <h1
        class="titulo-breaker titulo-breaker--bg-claro"
        style="color:var(--rojo)"
    >
        Ya casi está
    </h1>

    <div class="cuerpo">
        <p>
            Te contacto por teléfono lo antes posible para concretar cuándo
            agendamos llamada. Gracias por tu confianza.
        </p>
    </div>
</BaseLayout>
