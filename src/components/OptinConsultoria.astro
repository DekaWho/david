---
import OptinBase from "./OptinBase.astro";

/* Wrapper del optin de las consultorías 1a1 (/consultoria-ia y
   /consultoria-monetizar): ambas comparten form y automatización de
   bienvenida en MailerLite, así que el wrapper es común. Fija el form-id
   para que la automatización dispare por destino del submit, no por
   filtrado de UTMs posterior — los UTMs pueden faltar o llegar
   incorrectos; el form-id siempre llega correcto. El campo ultimo_optin
   (derivado del pathname) distingue desde qué landing se suscribió cada
   lead. Si una de las dos estrena form y automatización propios, crear
   su wrapper aparte y sustituir el import en su página. */
const CONSULTORIA_FORM_ID = "191928498304059114";

/* Defaults del botón para este lead magnet: el CTA pide una llamada 1a1
   (no una suscripción a emails, de ahí que el sobre genérico no valga) y
   el rayo repite el icono del bloque Consultoría de la home — el mismo
   símbolo acompaña el funnel entero. La página puede overridearlos; el
   form-id se fija siempre después del spread para que la página no pueda
   pisarlo. */
const {
    botonTexto = "Me interesa una llamada 1a1",
    botonIcono = "/imgs/svg/lightning.svg",
    ...rest
} = Astro.props;
---

<OptinBase
    {...rest}
    botonTexto={botonTexto}
    botonIcono={botonIcono}
    formId={CONSULTORIA_FORM_ID}
/>
