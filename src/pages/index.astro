---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    titulo="David Varea"
    canonical="/"
    ogTitle="🤝 David Varea"
    ogDescription="Cada segundo cuenta."
    ogUrl="https://davidvarea.com"
>
    <main class="stage">
        <section class="hero-card">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="hero-headline">
                Youtube es el mayor imán de
                <span class="hl-squiggle">
                    <span class="squiggle-text">leads cualificados</span>
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"></path>
                    </svg>
                </span>
                (sin necesidad de ser viral ni hacer vídeos como Mr.&nbsp;Beast)
            </h1>

            <div class="postit-wrap">
                <div class="postit">
                    <span class="tape" aria-hidden="true"></span>
                    Soy David Varea (las dos con V) Monetizador de audiencias y estratega
                    de contenido. <strong>Cada segundo cuenta</strong>.
                </div>
            </div>
        </section>

        <span class="section-arrow" aria-hidden="true"></span>

        <div class="section-heading">
            <span class="caret">▾</span>
            ¿Qué te trae por aquí?
        </div>

        <nav class="blocks" aria-label="Secciones">
            <a
                class="block block--secondary"
                href="/monetizar"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/lightning.svg" alt="⚡" />
                <span class="body">
                    <span class="subtitle-hand">La jugada más instantánea</span>
                    <span class="title">Para monetizar tu audiencia</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>

            <a
                class="block block--secondary block--wip"
                aria-disabled="true"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/broken-chain.svg" alt="⛓️‍💥" />
                <span class="body">
                    <span class="title">Desencadena tu Youtube</span>
                    <span class="subtitle-hand"
                        >más retención ➜ más clientes</span
                    >
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
        </nav>
    </main>

    <Footer />

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    ></script>
    <script is:inline>
        Sortable.create(document.querySelector(".blocks"), {
            handle: ".handle",
            animation: 150,
            ghostClass: "block--ghost",
        });
    </script>
</BaseLayout>
