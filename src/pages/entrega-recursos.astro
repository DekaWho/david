---
import BaseLayout from "../layouts/BaseLayout.astro";
import ElegirHora from "../components/ElegirHora.astro";
---

<BaseLayout
    titulo="¿Quieres ir más rápido?"
    favicon="warning"
    bodyClass="hoja-blanca"
    noindex={true}
    scripts={false}
    trackEvento="Lead"
>
    <div class="banner" style="padding-top: 1.5rem;">
        <section class="hero">
            <img class="hero-aviso" src="/imgs/svg/warning-color.svg" alt="" />
            <h1 style="color: var(--rojo);">¿Quieres ir más rápido?</h1>
            <p style="text-align: center; margin-bottom: var(--gap-sm);">
                <strong>
                    Te he enviado al email el acceso a la carpeta compartida con
                    todos los recursos disponibles.
                </strong>
                Si lo quieres es
                <u class="mark-amarillo">una ruta personalizada, </u>te cuento
                en una llamada de media hora cuál es el camino más rápido según
                tu situación.
            </p>
        </section>

        <ElegirHora />
    </div>
</BaseLayout>
