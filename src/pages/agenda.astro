---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
import Reviews from "../components/Reviews.astro";
import AgendarLlamada from "../components/AgendarLlamada.astro";
import CarruselVideos from "../components/CarruselVideos.astro";

// Para pausar el amago de scroll, cambiar la línea activa por esta:
// const bodyClass = "reviews-blanco oferta agenda title-alerta";
const bodyClass = "reviews-blanco oferta agenda title-alerta amago-scroll";
---

<BaseLayout
    titulo="¿Tu comisión del 10% te sabe a poco? Lanzamos al mercado tu propio servicio."
    canonical="/agenda"
    ogTitle="¿Tu comisión del 10% te sabe a poco? Lanzamos al mercado tu propio servicio."
    ogDescription="Solo para Closers."
    description="¿Tu comisión del 10% te sabe a poco? Lanzamos al mercado tu propio servicio para que te quedes el 100% de lo que generas."
    ogUrl="https://davidvarea.com/agenda"
    favicon="fire"
    bodyClass={bodyClass}
>
    <div class="banner">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">Solo para Closers</span>
            </h2>

            <h1 class="banner-h1--medium">
                Lanzamos al mercado{" "}
                <span class="squiggle">tu propio servicio</span> si un 10% de
                comisión te sabe a poco y te atreves a ir a por el{" "}
                <u class="mark-amarillo">100% de lo que generas</u>
            </h1>
            <AgendarLlamada />
        </section>
    </div>

    <div class="cuerpo">
        <h2 class="titulo-compacto">
            He estudiado <span class="squiggle">incontables horas</span> de
            contenido y he invertido 19.970€ en formación para diseñar y
            posicionar proyectos{" "}
            <span class="inciso-hand">
                (además de mi experiencia dando servicios en distintos nichos)
            </span>
            para que tú no tengas que hacerlo...
        </h2>

        <img
            class="banner-proof"
            src="/imgs/referentes.webp"
            alt="las caras de los referentes estudiados"
            loading="lazy"
            decoding="async"
        />
    </div>

    <Reviews id="opiniones" orden={["pascu", "gonzalo", "cristina", "rioboo"]}>
        <p slot="antes-audios">
            <strong>
                Esto dice
                <span class="squiggle">quien ha trabajado</span> conmigo.
            </strong>
        </p>
        <p slot="antes-audios">
            He dado servicios en distintos nichos hasta encontrar la mejor
            fórmula para diferenciar tu servicio incluso en un mercado saturado.
        </p>
    </Reviews>

    <div class="cuerpo">
        <AgendarLlamada />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <div class="cta-sticky">
        <AgendarLlamada posicion="99" />
    </div>

    <FooterDisclaimer />
</BaseLayout>
