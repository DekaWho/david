---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
    titulo="David Varea - Cada segundo cuenta"
    canonical="/"
    ogTitle="🤝 David Varea"
    ogDescription="Cada segundo cuenta. Desbloquea todo tu potencial."
    ogUrl="https://davidvarea.com"
>
    <main class="stage">
        <section class="hero-card">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="hero-headline">
                Mis clientes han facturado
                <span class="hl-squiggle">
                    <span class="squiggle-text">2.4 millones</span>
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"></path>
                    </svg>
                </span>
                de € en sus negocios con mi ayuda
            </h1>

            <div class="postit-wrap">
                <div class="postit">
                    <span class="tape" aria-hidden="true"></span>
                    Este título <span class="bold"
                        >va para el David Varea de hace 2 años:</span
                    > El que apostó por sí mismo cuando lo seguro era conformarse.
                </div>
            </div>
        </section>

        <span class="section-arrow" aria-hidden="true"></span>

        <div class="section-heading">
            <span class="caret">▾</span>
            ¿Qué te trae por aquí?
        </div>

        <nav class="blocks" aria-label="Secciones">
            <!-- <a
                class="block block--primary"
                href="/servicios#portfolio"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/lightning.svg" alt="⚡" />
                <span class="body">
                    <span class="title">Portfolio</span>
                    <span class="subtitle-hand"
                        >Logros conseguidos para otros clientes</span
                    >
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a> -->

            <a
                class="block block--primary"
                href="/consultoria-monetizar"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/lightning.svg" alt="⚡" />
                <span class="body">
                    <span class="subtitle-hand"
                        >si ya has tenido clientes antes...</span
                    >
                    <span class="title"
                        >Lee esto sobre monetizar audiencias</span
                    >
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>

            <a
                class="block block--secondary"
                href="/claude"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/broken-chain.svg" alt="⛓️‍💥" />
                <span class="body">
                    <span class="title">100 esclavos trabajando para ti</span>
                    <span class="subtitle-hand subtitle-hand--azul"
                        >Desencadena a tu IA</span
                    >
                </span>
                <span class="badge">SKILLS gratis</span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
        </nav>
    </main>

    <Footer />

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    ></script>
    <script is:inline>
        Sortable.create(document.querySelector(".blocks"), {
            handle: ".handle",
            animation: 150,
            ghostClass: "block--ghost",
        });
    </script>
</BaseLayout>
