---
// Copy del pitch de Róbame — fuente única. Lo monta el hero de /robame.
// `Tag` ajusta la semántica al contexto (h1 en la landing); la clase del
// contenedor la pasa quien monta. Los resaltados interiores (banner-mark,
// aside-hand, squiggle) son clases globales que funcionan en cualquier
// contexto.
const { Tag = "p", class: clase } = Astro.props;
---

<Tag class={clase}>
    Me he gastado <u class="banner-mark">19.970€ en cursos y mentorías</u> de marketing,
    viralidad, IA y emprendimiento <span class="aside-hand"
        >(aparte de mi experiencia dando servicios)</span
    >
    para que <span class="squiggle">tú no tengas que hacerlo</span>
</Tag>
