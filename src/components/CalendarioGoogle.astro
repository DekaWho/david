---
/* CTA que enlaza al calendario de citas de Google (Appointment Scheduling).
   Usa el patrón de tarjeta-enlace del sitio (.block block--primary: icono +
   título + flecha, como los enlaces de la home y el de Gmail en /not-done) en
   vez del iframe embebido, cuyo widget trae su propia UI (textos, enlaces de
   "más información") que ensucia la página. Abre el link de reserva en pestaña
   nueva. URL fija — si se regenera el calendario en Google, actualizarla aquí. */
const { texto = "Agendar en Google Meet" } = Astro.props;
const href = "https://calendar.app.google/2CpjfV4NZ7baPRsM9";
---

<a class="block block--calendario" href={href} target="_blank" rel="noopener">
    <img class="icon" src="/imgs/svg/google-calendar.svg" alt="" />
    <span class="body">
        <span class="title">{texto}</span>
    </span>
    <span class="arrow" aria-hidden="true">→</span>
</a>
