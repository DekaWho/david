---
import BaseLayout from "../layouts/BaseLayout.astro";
import Menu from "../components/Menu.astro";
import Logros from "../components/Logros.astro";
import Reviews from "../components/Reviews.astro";
import OptinConsultoriaMonetizar from "../components/OptinConsultoriaMonetizar.astro";
---

<BaseLayout
    titulo="La jugada más instantánea que puedes hacer para monetizar tu audiencia"
    ogTitle="La jugada más instantánea que puedes hacer para monetizar tu audiencia"
    canonical="/consultoria-monetizar"
    ogUrl="https://davidvarea.com/consultoria-monetizar"
    favicon="lightning"
    bodyClass="reviews-blanco"
    exitPopup={false}
>
    <Menu
        enlaces={[
            { href: "#resultados", label: "Resultados" },
            { href: "#opiniones", label: "Opiniones" },
            { href: "#que-ofrezco", label: "Qué recibes", flechaDer: "↓" },
        ]}
    />

    <div class="banner">
        <section class="hero">
            <h1>
                La jugada más instantánea que puedes hacer para <u
                    class="mark-amarillo">monetizar tu audiencia</u
                >
                <span class="aside-hand"
                    >(solo funciona si ya has tenido clientes antes)</span
                >
            </h1>

            <img
                class="hero-rayo"
                src="/imgs/svg/lightning.svg"
                alt=""
                aria-hidden="true"
            />

            <p class="hero-spoiler">
                <strong style="color: var(--rojo)">Spoiler: </strong>
                A veces necesitas un nuevo enfoque pero otras necesitas lanzar lo
                que llevas semanas preparando. <span class="squiggle"
                    >Breve contexto</span
                >:
            </p>

            <h2 class="titulo-seccion hand" style="text-align: left">
                Hola <img
                    class="emoji"
                    src="/imgs/svg/handshake.svg"
                    alt="🤝"
                /><br />
                soy David Varea
            </h2>

            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                    loading="lazy"
                />
            </div>

            <h2 class="titulo-compacto">
                Me he gastado <u class="banner-mark"
                    >19.970€ en cursos y mentorías</u
                > de viralidad, marca personal y monetizar online <span
                    class="aside-hand"
                    >(además de mi experiencia dando servicios)</span
                >
                para que <span class="squiggle">tú no tengas que hacerlo</span>
            </h2>

            <img
                class="banner-proof"
                src="/imgs/heads.webp"
                alt="las caras de los referentes estudiados"
                loading="eager"
                decoding="async"
            />

            <p>
                Y puedo guiarte (en una llamada de 47min) para darte <span
                    class="text-rojo">la jugada más insantánea</span
                > que puedes hacer para monetizar tu audiencia. Te mando un correo
                con
                <u class="mark-amarillo">todos los detalles y el precio:</u>
            </p>

            <OptinConsultoriaMonetizar />
        </section>
    </div>

    <div class="cuerpo">
        <h2 style="font-family: var(--hand);">Te cuento un poco más</h2>
        <p>En 2019 me di de alta como autónomo...</p>

        <p>
            <strong>
                Aparte de saber dar el servicio (de editor de vídeo) tuve que
                aprender sobre emprender, marketing, captar clientes (sin tener
                millones de visitas) o finanzas <del class="tachado-rojo"
                    >para cuando llega nuestra socia obligatoria Hacienda <span
                        class="emoji-tachado"
                        ><img
                            class="emoji"
                            src="/imgs/svg/skull.svg"
                            alt="💀"
                        /></span
                    ></del
                >
            </strong>
        </p>

        <span class="doodle doodle--pesas" aria-hidden="true"></span>

        <p>
            Me obsesioné tanto con entender <u class="mark-amarillo"
                >las mejores formas de rentabilizar una misma audiencia</u
            > que dejé de ser editor de vídeo.
        </p>
        <p>
            <strong>
                Me convertí en monetizador de audiencias. Dando servicios a
                ecommerce, infoproductores u otros negocios de servicios.
            </strong>
        </p>

        <section class="seccion-blanca" id="resultados">
            <h2 style="font-family: var(--hand); color: var(--azul)">
                Qué han logrado mis clientes
            </h2>
            <div class="diamond" aria-hidden="true"></div>
            <p>
                Mis clientes han facturado 2.4 millones de € usando mis
                servicios. Te cuento qué hice para ellos pero antes una
                aclaración:
            </p>

            <Logros />
            <span class="gladiador icono-solido" aria-hidden="true"></span>
        </section>
    </div>
    <Reviews id="opiniones" />

    <div class="cuerpo">
        <h2
            id="que-ofrezco"
            style="font-family: var(--hand); color: var(--rojo)"
        >
            Qué recibes exactamente
        </h2>

        <ul>
            <li>
                <strong>
                    Una llamada de 47 minutos conmigo, David Varea. Antes de
                    reunirnos me leo tus inquietudes para llegar con contexto
                    sobre tu caso.
                </strong>
            </li>
            <li>
                Sales con un par de jugadas bajo la manga:
                <ol>
                    <li>
                        La acción más inmediata que puedes hacer para monetizar
                        tu audiencia (A veces necesitas un nuevo enfoque pero
                        otras necesitas lanzar lo que llevas semanas preparando
                        porque ya es suficientemente bueno).
                    </li>
                    <li>
                        Después: Cómo convertirlo en ingresos recurrentes sin
                        tener que acertar cada vez. Dar un pelotazo está
                        fantástico, pero seguir cobrando cada mes está mejor.
                    </li>
                </ol>
            </li>
            <li>
                <strong>
                    Seguimiento extra de 21 días. Tendré tu conversación fijada
                    en mi watsapp (solo una temática por consulta. Podrás
                    plantear la siguiente cuando la responda)
                </strong>
            </li>
            <li>
                Transcripción de la llamada y el plan por escrito. Consúltalo
                cuando lo necesites.
            </li>
        </ul>

        <span class="buscando icono-solido" aria-hidden="true"></span>

        <h2 style="font-family: var(--hand); margin-top: var(--gap-2xl);">
            Para <span class="ink-circle ink-circle--azul"
                >quién<svg
                    class="ink-circle-svg"
                    viewBox="0 0 100 60"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        d="M 52 6 C 80 7 96 19 94 33 C 93 49 76 55 50 56 C 23 56 6 48 6 30 C 7 14 25 5 52 6"
                        stroke="currentColor"
                        stroke-width="1.5"
                        fill="none"
                        stroke-linecap="round"></path></svg
                ></span
            > es
        </h2>
        <p>
            <strong>
                Esta llamada tiene sentido si estás en una de estas 3 fases:
            </strong>
        </p>
        <ol type="A">
            <li>
                Llevas semanas a punto de hacer un lanzamiento (o una nueva
                campaña) pero algo te frena.
            </li>
            <li>
                <strong>
                    Ya tienes tu propia audiencia (aunque sea pequeña y no
                    tengas ningún vídeo viral) pero no la estás monetizando lo
                    suficiente. A grandes rasgos se puede ganar 1€ al mes por
                    cada suscriptor (activo) que tienes.
                </strong>
            </li>
            <li>
                Tu negocio funciona pero ves a la competencia facturando más con
                un peor servicio.
            </li>
        </ol>
        <p>
            <strong>
                Tres casos distintos donde puedo guiarte para monetizar. Te
                mando un email con el precio de la llamada 1 a 1. Aún no tengo <u
                    class="mark-amarillo">la tarifa de 500€/h (</u
                >pero más pronto que tarde ese será el precio)
            </strong>
        </p>

        <OptinConsultoriaMonetizar />
    </div>
    <div class="flecha flecha--up" aria-hidden="true"></div>
</BaseLayout>

{
    /* Title parpadeante estilo notificación de WhatsApp: se dispara cuando el
        lector deja de mirar la página, para reengancharlo. Cubre los dos casos
        de "irse": cambiar de pestaña/minimizar (visibilitychange) y mover el
        foco a otro programa con la pestaña aún activa (blur de window) — este
        último no levanta document.hidden, de ahí los dos disparadores y el
        document.hasFocus(). Al recuperar foco se restaura el título. Inline
        porque solo lo llevan las landings que lo montan, no el sitio entero
        (scripts.js). */
}
<script is:inline>
    (function () {
        const original = document.title;
        const alerta = "(1) " + original;
        let timer = null;
        let mostrandoAlerta = false;

        function arrancar() {
            if (timer) return;
            timer = setInterval(function () {
                document.title = mostrandoAlerta ? original : alerta;
                mostrandoAlerta = !mostrandoAlerta;
            }, 1000);
        }

        function parar() {
            clearInterval(timer);
            timer = null;
            document.title = original;
        }

        function sincronizar() {
            if (document.hidden || !document.hasFocus()) arrancar();
            else parar();
        }

        document.addEventListener("visibilitychange", sincronizar);
        window.addEventListener("blur", sincronizar);
        window.addEventListener("focus", sincronizar);
    })();
</script>
