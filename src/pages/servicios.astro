---
/* Versión CV de la oferta: la página que se manda suelta (email, DM) a un dueño
   de negocio que ya está hablando con David. Comparte cuerpo con /desatascar
   (la landing enlazada desde la home) pero con el titular del marrón, el
   portfolio dentro y un cierre que no pide agendar llamada: quien la lee
   contesta por el canal por el que le llegó el enlace. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Menu from "../components/Menu.astro";
import Logros from "../components/Logros.astro";
import Reviews from "../components/Reviews.astro";

/* Los mismos destinos en las dos instancias del menú: la fila del banner
   (enFlujo) y la barra fija que la releva al scrollear. Tres etiquetas, que es
   lo que la fila aguanta en una línea a 375px; el «Qué hago» que enlaza
   /desatascar no cabe y aquí sobra: es el primer párrafo bajo el banner. */
const SECCIONES = [
    { href: "#portfolio", label: "Portfolio" },
    { href: "#opiniones", label: "Opiniones" },
    { href: "#trabajar-juntos", label: "Trabajar juntos", flechaDer: "↓" },
];
---

<BaseLayout
    titulo="David Varea"
    canonical="/servicios"
    ogTitle="David Varea 🤝"
    ogDescription="Hay dos tipos de fuego en todo negocio..."
    ogUrl="https://davidvarea.com/servicios"
    favicon="handshake"
    bodyClass="title-alerta servicios"
>
    <Menu enlaces={SECCIONES} />

    <div class="banner">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2>

            <h1>
                Pásame tu mayor dolor de cabeza <span class="aside-hand"
                    >(en marketing y ventas)</span
                > y <u class="mark-amarillo">duerme tranquilo</u>
            </h1>
