---
import BaseLayout from "../layouts/BaseLayout.astro";
import FooterDisclaimer from "../components/FooterDisclaimer.astro";
import Reviews from "../components/Reviews.astro";
import AgendarLlamada from "../components/AgendarLlamada.astro";
import CarruselVideos from "../components/CarruselVideos.astro";
---

<BaseLayout
    titulo="¿Necesitas una auditoría?"
    canonical="/agenda"
    ogTitle="¿Necesitas una auditoría?"
    ogUrl="https://davidvarea.com/agenda"
    favicon="fire"
    bodyClass="reviews-blanco oferta agenda title-alerta amago-scroll"
>
    <div class="banner">
        <section class="hero">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <!-- <h2>
                <span class="banner-subline">
                    <img class="emoji" src="/imgs/svg/handshake.svg" alt="🤝" />
                    David Varea
                </span>
            </h2> -->

            <h1 class="banner-h1--medium">
                Audito y mejoro la oferta de
                <u class="mark-amarillo">quien da servicios</u>{" "}
                <span class="inciso-ligero">(en mercados saturados)</span> para
                posicionarte como irremplazable
            </h1>
            <AgendarLlamada />
            <p class="inciso-hand">
                El 83% de los servicios se han convertido en una commodity
                <span class="text-rojo">sustituible por la IA</span> (y aunque
                el tuyo no lo sea, tus clientes{" "}
                <span class="squiggle">pueden sentir que sí)</span>
            </p>

            <p>
                <u class="mark-amarillo">Si agendas llamada</u> para{" "}
                <strong>el diagnóstico gratis</strong> te contaré el pequeño
                ajuste que tienes que hacer en la comunicación para aumentar la
                conversión y la retención de tus clientes.
            </p>
        </section>
    </div>

    <div class="cuerpo">
        <CarruselVideos
            videos={[
                {
                    id: "wZNt7pcrt3I",
                    titulo: "Día 1 mejorando la oferta de un Media Buyer",
                },
            ]}
        />

        <section class="seccion-blanca">
            <h2 class="titulo-compacto">
                Me he gastado 19.970€ en cursos y mentorías de marketing y
                ventas{" "}
                <span class="inciso-ligero">
                    (además de mi experiencia dando servicios)
                </span>
                para que tú no tengas que hacerlo...
            </h2>

            <img
                class="banner-proof"
                src="/imgs/heads.webp"
                alt="las caras de los referentes estudiados"
                loading="lazy"
                decoding="async"
            />
        </section>
    </div>

    <Reviews id="opiniones" orden={["pascu", "rioboo", "gonzalo", "chuso"]} />

    <div class="cuerpo">
        <AgendarLlamada />

        <div class="flecha flecha--up" aria-hidden="true"></div>
    </div>

    <div class="cta-sticky">
        <AgendarLlamada posicion="99" />
    </div>

    <FooterDisclaimer />
</BaseLayout>
