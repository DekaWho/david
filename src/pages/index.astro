---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { CALENDARIO_URL } from "../data/calendario.js";
---

<BaseLayout
    titulo="David Varea (las 2 con V)"
    canonical="/"
    ogTitle="🤝 David Varea"
    ogDescription="Cada segundo cuenta."
    ogUrl="https://davidvarea.com"
    bodyClass="home"
>
    <main class="stage">
        <section class="hero-card">
            <div class="hero-photo-wrap">
                <img
                    class="hero-photo"
                    src="/imgs/profile-pic.webp"
                    alt="David Varea"
                />
            </div>

            <h1 class="hero-headline">
                Hay solo dos cosas que
                <span class="hl-squiggle"
                    >mueven el mundo:
                    <svg
                        class="squiggle-svg"
                        viewBox="0 0 140 10"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M2 5 Q 35 1 70 5 T 138 5"
                            stroke-width="2.4"
                            fill="none"
                            stroke-linecap="round"></path>
                    </svg>
                </span>
            </h1>

            <ol class="hero-opciones">
                <li>El dinero.</li>
                <li>La persuasión.</li>
            </ol>

            <div class="postit-wrap">
                <div class="postit">
                    <span class="tape" aria-hidden="true"></span>
                    Soy <strong>David Varea</strong> (las dos con V)<br /><br
                    />¿Qué te trae por aquí?
                </div>
            </div>
        </section>

        <div class="section-heading"></div>

        <nav class="blocks" aria-label="Secciones">
            <a
                class="block block--secondary block--solo-titulo"
                href="/youtube"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/youtube.svg" alt="📷" />
                <span class="body">
                    <span class="title">Exprimir Youtube</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>

            <a
                class="block block--secondary block--solo-titulo"
                href="/servicios"
                target="_blank"
                rel="noopener"
                draggable="false"
            >
                <span class="handle" aria-hidden="true">⋮⋮</span>
                <img class="icon" src="/imgs/svg/bottle.svg" alt="🍾" />
                <span class="body">
                    <span class="title">Desatascar tu negocio</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
        </nav>

        <p class="titulo-mano titulo-mano--nota">Cada segundo cuenta.</p>
    </main>

    <!-- <Footer /> -->

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"
    ></script>
    <script is:inline>
        Sortable.create(document.querySelector(".blocks"), {
            handle: ".handle",
            animation: 150,
            ghostClass: "block--ghost",
        });
    </script>
</BaseLayout>
